# Local development. Copy to .env; never commit real credentials.
TELEGRAM_BOT_TOKEN=
PORT=3000
NODE_ENV=development

# Matches the README local database command. Change for production.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=tg_bot_app
DB_PASSWORD=local_dev_only
DB_DATABASE=tg_bot_news

# Set exact model IDs available to your Google API project.
# The generation model is shared by summarization and research.
GOOGLE_API_KEY=
GEMINI_SUMMARY_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# For Docker Compose use http://qdrant:6333 instead.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=news_summaries_local
QDRANT_CHUNKS_COLLECTION=news_summary_chunks_local
NEWS_CHUNK_SIZE=800
NEWS_CHUNK_OVERLAP=150

# Enable after configuring credentials. Manual research still calls the API.
NEWS_CONTENT_PROCESSING_ENABLED=false
NEWS_INDEXING_ENABLED=false
NEWS_INGESTION_ENABLED=false

# Optional tests: use only a disposable database named tg_news_test.
# TEST_DATABASE_URL=postgresql://test:test@127.0.0.1:55432/tg_news_test
